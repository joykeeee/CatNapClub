+HAND_POINTS = (15, 16, 17, 18, 19, 20, 21, 22)  # wrists, pinkies, index fingers, thumbs
+
+
+def bottle_holders(boxes, hands, reach=.75):
+    """Owner of each bottle: {box index: slot} for boxes with a visible hand point nearby.
+
+    A hand point counts when it is inside the bottle box widened by `reach` box sizes.
+    boxes are (x0, y0, x1, y1) and hands {slot: [(x, y), ...]}, all in frame coordinates (0-1).
+    Each bottle goes to the slot with the hand point nearest its centre, so a bottle on a
+    table or in someone else's hand does not count for the wrong person.
+    """
+    owners = {}
+    for box, (x0, y0, x1, y1) in enumerate(boxes):
+        pad = reach * max(x1 - x0, y1 - y0)
+        centre = ((x0 + x1) / 2, (y0 + y1) / 2)
+        nearest = None
+        for slot, points in hands.items():
+            for x, y in points:
+                if x0 - pad <= x <= x1 + pad and y0 - pad <= y <= y1 + pad:
+                    distance = math.dist((x, y), centre)
+                    if nearest is None or distance < nearest[0]:
+                        nearest = (distance, slot)
+        if nearest is not None:
+            owners[box] = nearest[1]
+    return owners
+
