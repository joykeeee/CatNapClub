diff --git a/Tracking/test_bottle.py b/Tracking/test_bottle.py
new file mode 100644
index 0000000..e55a20c
--- /dev/null
+++ b/Tracking/test_bottle.py
@@ -0,0 +1,32 @@
+import unittest
+from bridge import bottle_holders
+
+
+class BottleTests(unittest.TestCase):
+    # A bottle about 4 % of the frame wide and 15 % tall, held up at P3's right (x ~ .8).
+    BOTTLE = (.78, .20, .82, .35)
+
+    def test_wrist_on_the_bottle_counts(self):
+        self.assertEqual(bottle_holders([self.BOTTLE], {3: [(.80, .33)]}), {0: 3})
+        # A wrist just below the bottle (hand wrapped around its base) still counts.
+        self.assertEqual(bottle_holders([self.BOTTLE], {3: [(.80, .42)]}), {0: 3})
+
+    def test_finger_points_count_like_wrists(self):
+        # Wrist hidden behind the bottle, but index finger and thumb are on it.
+        self.assertEqual(bottle_holders([self.BOTTLE], {3: [(.79, .27), (.81, .28)]}), {0: 3})
+
+    def test_bottle_away_from_every_hand_does_not_count(self):
+        self.assertEqual(bottle_holders([self.BOTTLE], {1: [(.15, .5)], 2: [(.5, .5)], 3: [(.80, .70)]}), {})
+        self.assertEqual(bottle_holders([], {3: [(.80, .33)]}), {})
+        self.assertEqual(bottle_holders([self.BOTTLE], {3: []}), {})
+
+    def test_nearest_hand_owns_the_bottle(self):
+        self.assertEqual(bottle_holders([self.BOTTLE], {2: [(.74, .38)], 3: [(.80, .30)]}), {0: 3})
+
+    def test_each_bottle_is_assigned_separately(self):
+        other = (.48, .40, .52, .55)
+        self.assertEqual(bottle_holders([self.BOTTLE, other], {2: [(.50, .52)], 3: [(.81, .30)]}), {0: 3, 1: 2})
+
+
+if __name__ == '__main__':
+    unittest.main()
