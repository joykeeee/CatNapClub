+def zone_bounds(count, overlap=.06):
+    """Equal vertical strips, P1 leftmost in the unmirrored image.
+
+    Each detection crop is widened by `overlap` (fraction of frame width) so arms reaching
+    past a line are still seen; the body centre must still fall inside the strip itself.
+    """
+    return [((i / count, (i + 1) / count),
+             (max(0., i / count - overlap), min(1., (i + 1) / count + overlap)))
+            for i in range(count)]
+
+
+def to_frame(landmarks, crop):
+    """Map landmarks from a full-height crop back to whole-frame coordinates."""
+    left, right = crop
+    return [SimpleNamespace(x=left + p.x * (right - left), y=p.y,
+                            visibility=p.visibility, presence=p.presence) for p in landmarks]
+
+
+def zone_choice(centers, strip):
+    """Index of the body centred nearest the middle of its strip, or None if none is inside."""
+    middle = (strip[0] + strip[1]) / 2
+    inside = [i for i, c in enumerate(centers) if strip[0] <= c[0] < strip[1]]
+    return min(inside, key=lambda i: abs(centers[i][0] - middle), default=None)
+
+
