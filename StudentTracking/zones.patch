diff --git a/Tracking/test_zones.py b/Tracking/test_zones.py
new file mode 100644
index 0000000..86af866
--- /dev/null
+++ b/Tracking/test_zones.py
@@ -0,0 +1,79 @@
+import unittest
+from types import SimpleNamespace
+from bridge import extract_features, to_frame, zone_bounds, zone_choice
+
+
+def body(points, size=33):
+    landmarks = [SimpleNamespace(x=.5, y=.5, presence=0., visibility=0.) for _ in range(size)]
+    for i, (x, y) in points.items():
+        landmarks[i] = SimpleNamespace(x=x, y=y, presence=1., visibility=1.)
+    return landmarks
+
+
+class ZoneTests(unittest.TestCase):
+    def test_strips_cover_the_frame_left_to_right(self):
+        for count in (1, 2, 3, 4):
+            zones = zone_bounds(count)
+            self.assertEqual(len(zones), count)
+            self.assertEqual(zones[0][0][0], 0)
+            self.assertEqual(zones[-1][0][1], 1)
+            for (strip, crop), (following, _) in zip(zones, zones[1:]):
+                self.assertEqual(strip[1], following[0])
+            for strip, crop in zones:
+                self.assertLessEqual(crop[0], strip[0])
+                self.assertGreaterEqual(crop[1], strip[1])
+                self.assertGreaterEqual(crop[0], 0)
+                self.assertLessEqual(crop[1], 1)
+        self.assertEqual(zone_bounds(1), [((0, 1), (0, 1))])
+
+    def test_crop_landmarks_map_back_to_the_frame(self):
+        crop = (1 / 3 - .06, 2 / 3 + .06)
+        mapped = to_frame([SimpleNamespace(x=0., y=.2, visibility=.9, presence=.8),
+                           SimpleNamespace(x=1., y=.7, visibility=.4, presence=1.)], crop)
+        self.assertAlmostEqual(mapped[0].x, crop[0])
+        self.assertAlmostEqual(mapped[1].x, crop[1])
+        self.assertEqual((mapped[0].y, mapped[0].visibility, mapped[0].presence), (.2, .9, .8))
+
+    def test_one_body_per_zone_nearest_the_middle(self):
+        strip = (1 / 3, 2 / 3)
+        self.assertIsNone(zone_choice([], strip))
+        self.assertIsNone(zone_choice([(.3, .5), (.7, .5)], strip))
+        self.assertEqual(zone_choice([(.3, .5), (.45, .5)], strip), 1)
+        self.assertEqual(zone_choice([(.38, .5), (.52, .5), (.64, .5)], strip), 1)
+
+    def test_full_body_and_seated_centres_pick_the_right_zone(self):
+        zones = zone_bounds(3)
+        # Middle performer: shoulders/hips in the centre strip, one arm reaching into P1's strip.
+        crop = zones[1][1]
+        width = crop[1] - crop[0]
+        def local(x):
+            return (x - crop[0]) / width
+        standing = body({11: (local(.45), .3), 12: (local(.55), .3), 23: (local(.46), .6),
+                         24: (local(.54), .6), 15: (local(.30), .3), 16: (local(.60), .5),
+                         27: (local(.46), .9), 28: (local(.54), .9)})
+        seated = body({11: (local(.45), .5), 12: (local(.55), .5), 15: (local(.30), .5),
+                       16: (local(.60), .7)})
+        for landmarks, upper in ((standing, False), (seated, True)):
+            center, _, confidence = extract_features(to_frame(landmarks, crop), upper)
+            self.assertAlmostEqual(center[0], .5)
+            self.assertGreaterEqual(confidence[4], .5)
+            self.assertEqual([zone_choice([center], strip) for strip, _ in zones], [None, 0, None])
+
+    def test_features_match_whole_frame_detection(self):
+        # The same pose seen in a crop or in the whole frame gives the same Unity values.
+        whole = body({11: (.45, .3), 12: (.55, .3), 23: (.46, .6), 24: (.54, .6),
+                      15: (.40, .1), 16: (.62, .5), 27: (.46, .85), 28: (.54, .9)})
+        crop = zone_bounds(3)[1][1]
+        width = crop[1] - crop[0]
+        cropped = [SimpleNamespace(x=(p.x - crop[0]) / width, y=p.y, visibility=p.visibility,
+                                   presence=p.presence) for p in whole]
+        for upper in (False, True):
+            expected = extract_features(whole, upper)
+            actual = extract_features(to_frame(cropped, crop), upper)
+            for a, b in zip(expected[1], actual[1]):
+                self.assertAlmostEqual(a, b)
+            self.assertEqual(expected[2], actual[2])
+
+
+if __name__ == '__main__':
+    unittest.main()
